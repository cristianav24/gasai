{
  "expo": {
    "name": "GasAI Repartidor",
    "slug": "gasai-repartidor",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gasai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f59e0b"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gasai.repartidor"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "extra": {
      "apiBaseUrl": "http://192.168.1.100:8000"
    }
  }
}
