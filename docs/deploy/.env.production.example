# .env de producción para GasAI en tandix.app (VPS Ubuntu / Contabo)
# Copia este archivo a .env en el servidor y completa los valores marcados <...>.

APP_NAME=GasAI
APP_ENV=production
APP_KEY=            # se genera en el server con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://tandix.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# --- Base de datos (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gasai
DB_USERNAME=gasai
DB_PASSWORD=<CONTRASEÑA_FUERTE_DB>

# --- Redis + colas + caché + sesión (producción usa Redis, no la BD) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# --- LLM del agente (DeepSeek) ---
DEEPSEEK_API_KEY=<TU_API_KEY_DEEPSEEK>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=<TOKEN_QUE_ELIJAS_Y_PEGUES_EN_META>
# WHATSAPP_APP_SECRET=<opcional: activa la validación de firma del webhook>

# --- Correo (ajusta a tu proveedor) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tandix.app"
MAIL_FROM_NAME="${APP_NAME}"
